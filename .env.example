# ╔═══════════════════════════════════════════════════════════╗
# ║                  ENVIRONMENT VARIABLES                    ║
# ║           Copy this to .env and fill in values            ║
# ╚═══════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://remesa:remesa_secret_password@localhost:5432/remesa_db

# ─────────────────────────────────────────────────────────────
# JWT (Authentication)
# Generate a secure random string for production!
# ─────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─────────────────────────────────────────────────────────────
# STRIPE (Payments)
# Get these from: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─────────────────────────────────────────────────────────────
# STELLAR (Blockchain)
# For testnet, create at: https://laboratory.stellar.org/
# ─────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_MEXICO_WALLET=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Issuer (Circle's USDC on Stellar)
# Testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ─────────────────────────────────────────────────────────────
# BITSO (Mexico Payouts)
# Get these from: https://bitso.com/api_setup
# ─────────────────────────────────────────────────────────────
BITSO_API_URL=https://api-sandbox.bitso.com
BITSO_API_KEY=your_bitso_api_key
BITSO_API_SECRET=your_bitso_api_secret

# ─────────────────────────────────────────────────────────────
# TWILIO (SMS)
# Get these from: https://console.twilio.com/
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─────────────────────────────────────────────────────────────
# CORS (Optional)
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
